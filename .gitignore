# PlatformIO build artefacts
.pio/
build/

# Generated UI headers (scripts/embed_ui.py regenerative them on every build)
include/ui_*.gz.h

# IDE / editor
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
*.code-workspace

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
.python-version

# Logs
*.log

# Secrets (never commit real credentials; template is include/secrets.example.h)
include/secrets.h
**/secrets.h
**/secrets.local.h

# Firmware binaries (if placed in project root)
*.bin
*.elf
*.hex
*.map
*.uf2
